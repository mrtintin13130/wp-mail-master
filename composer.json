{
    "name": "martho/wp-mail-master",
    "require": {
        "php": ">=8.1",
        "phpmailer/phpmailer": "^6.9",
        "getbrevo/brevo-php": "^2.0",
        "sendgrid/sendgrid": "~7",
        "mailjet/mailjet-apiv3-php": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Martho\\WpMailMaster\\": ["includes/", "/admin"]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Martho\\WpMailMaster\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.23"
        }
    },
    "authors": [
        {
            "name": "martho"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "10up/wp_mock": "^0.4.2"
    },
    "scripts": {
        "test": "phpunit",
        "test:verbose": "phpunit -v",
        "test:coverage": "phpunit --coverage-html coverage"
    }
}
